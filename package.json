{
  "name": "dsh-parallax",
  "version": "0.1.0",
  "description": "Conversations in DeepSeek Harness (dsh) that talk to each other: send, ask and reply with receipts, delegate with approval, read a bounded peer summary.",
  "license": "MIT",
  "author": "NakliTechie",
  "homepage": "https://github.com/NakliTechie/parallax#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NakliTechie/parallax.git"
  },
  "bugs": {
    "url": "https://github.com/NakliTechie/parallax/issues"
  },
  "type": "module",
  "main": "src/dsh.js",
  "exports": {
    ".": "./src/dsh.js",
    "./core": "./src/core.js",
    "./manifest": "./src/manifest.js",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agents",
    "multi-agent",
    "messaging",
    "delegation"
  ],
  "scripts": {
    "test": "node --import ./test/stubs/register.mjs --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": ">=0.2.1-rc.5"
  }
}
